{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameHub",
  "version": "0.1.1",
  "identifier": "com.github.gamehub",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GameHub",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$CACHE/gamehub/**", "$HOME/.local/share/gamehub/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Unified game launcher for Linux",
    "longDescription": "GameHub brings Steam, Heroic and manual Windows games into one launcher with Proton management, ProtonDB ratings and SteamGridDB artwork.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
